# ===========================================
# 必要环境变量（缺失将导致应用无法访问）
# ===========================================

# GitHub OAuth 配置
# 在 GitHub → Settings → Developer settings → OAuth Apps 获取
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# JWT 密钥（用于用户认证会话签名）
# 生成命令: openssl rand -hex 32
JWT_SECRET=your_jwt_secret

# 加密密钥（用于加密存储私钥和验证 Webhook 签名）
# 生成命令: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key

# 数据库连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://user:password@localhost:5432/manticore

# ===========================================
# GitHub App 配置（可选，用于 CI/CD 功能）
# ===========================================

# GitHub App ID（在 App 设置页顶部获取）
GITHUB_APP_ID=123456

# GitHub App Slug（用于机器人 @mention 匹配）
GITHUB_APP_SLUG=your-app-slug

# GitHub App 私钥文件路径
GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# Webhook 签名密钥（GitHub App 设置页的 Webhook secret）
# ⚠️ 与 ENCRYPTION_KEY 分离是安全最佳实践：此值对 GitHub 侧管理员可见，
# 不应复用派生数据库加密的 ENCRYPTION_KEY；未配置时兼容回落 ENCRYPTION_KEY
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ===========================================
# Qwen Code 配置（AI 自动化引擎）
# ===========================================

# ⚠️ Qwen 不通过环境变量配置。
# 请登录后在仪表盘「设置」页填写 Qwen Code 的 settings.json 内容并保存，
# 系统会自动写入运行环境的 ~/.qwen/settings.json。

# 定时扫描触发 Token（可选，用于外部 cron 触发 /api/ci/scan）
SCAN_TRIGGER_TOKEN=your_scan_token

# ===========================================
# 应用配置
# ===========================================

# 应用公开地址（用于 OAuth 回调）
APP_URL=http://localhost:3001

# ===========================================
# CI/CD 可选配置
# ===========================================

# CI 检查步骤超时时间（毫秒，默认 600000 = 10 分钟）
# CI_STEP_TIMEOUT_MS=600000

# Qwen 最大运行时间（毫秒，默认 1200000 = 20 分钟）
# QWEN_MAX_DURATION_MS=1200000

# Qwen 单次调用超时时间（毫秒，默认 600000 = 10 分钟）
# QWEN_TIMEOUT_MS=600000
